# Configurações do Django
SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados PostgreSQL
DB_NAME=ontickets_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS — origens permitidas para o frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Superuser criado automaticamente na primeira inicialização
ADMIN_EMAIL=admin@ontickets.com
ADMIN_PASSWORD=admin123
